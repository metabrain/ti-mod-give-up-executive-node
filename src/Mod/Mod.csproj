<Project Sdk="Microsoft.NET.Sdk">
  <!-- Adapted from ti-mod-template's MIT-licensed UMM starter. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>Local.GiveUpNation</AssemblyName>
    <RootNamespace>GiveUpNation</RootNamespace>
    <Version>0.2.3</Version>
    <Deterministic>true</Deterministic>
    <ManagedDir>$(TerraInvictaDir)/TerraInvicta_Data/Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp;Assembly-CSharp-firstpass;UnityEngine;UnityEngine.CoreModule;UnityEngine.UI;UnityEngine.UIModule;Unity.TextMeshPro;UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityModManager;0Harmony">
      <HintPath>$(ManagedDir)/UnityModManager/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(TerraInvictaDir)' == ''" Text="Pass -p:TerraInvictaDir=path to the read-only game installation." />
    <Error Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')" Text="Missing reference: %(Reference.HintPath)" />
  </Target>
</Project>
